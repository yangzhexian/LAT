{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/hy-mt2-gateway",
          "sidecar": true,
          "args": ["serve"]
        }
      ]
    },
    "shell:allow-kill"
  ]
}
